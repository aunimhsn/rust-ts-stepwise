   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "The robot bumped into a wall.\nforward() needs a free cell in front of the robot.",
   "originalText": "The robot bumped into a wall.\nforward() needs a free cell in front of the robot.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v1-text-571",
   "type": "text",
   "x": 0,
   "y": 2656,
   "width": 957.0000000000001,
   "height": 56.25,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1569090357,
   "version": 1,
   "versionNonce": 393904949,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "The robot bumps and the program stops: the line of the error is marked (✕), the map stays as it was at that moment.\nThe console shows the error; the dot on Variables says that it holds the state at the error (length = 5, the calls).\nThe program has ended: the code can be changed at once, without Reset; Run starts again from the start.",
   "originalText": "The robot bumps and the program stops: the line of the error is marked (✕), the map stays as it was at that moment.\nThe console shows the error; the dot on Variables says that it holds the state at the error (length = 5, the calls).\nThe program has ended: the code can be changed at once, without Reset; Run starts again from the start.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
