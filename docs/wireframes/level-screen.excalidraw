   "seed": 1428150522,
   "version": 1,
   "versionNonce": 372587780,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "A menu bar in the header, as in an IDE: Level, Edit, Run, Help. In the middle, the title of the level opens its goal;\nthe levels are numbered across the chapters; a thin bar along the bottom of the header shows the levels done (on hover: \"17 of 20 levels done\").\nThe previous and the next level are in the Level menu only, so that they are never clicked by mistake. The controls float\nas three squares in the corner of the code, pale while typing; the status bar holds the state, the steps, the speed and the position.\nThe maps of the level (its variants) on the right of the header, above the map (hidden when the level has one map):\nthe shown map has a full background; the bar under a map is green once it passed, grey until then (and again when the code changes). Console and variables share tabs.",
   "originalText": "A menu bar in the header, as in an IDE: Level, Edit, Run, Help. In the middle, the title of the level opens its goal;\nthe levels are numbered across the chapters; a thin bar along the bottom of the header shows the levels done (on hover: \"17 of 20 levels done\").\nThe previous and the next level are in the Level menu only, so that they are never clicked by mistake. The controls float\nas three squares in the corner of the code, pale while typing; the status bar holds the state, the steps, the speed and the position.\nThe maps of the level (its variants) on the right of the header, above the map (hidden when the level has one map):\nthe shown map has a full background; the bar under a map is green once it passed, grey until then (and again when the code changes). Console and variables share tabs.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
