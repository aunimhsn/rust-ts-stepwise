   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Layout C, the path, at 1280 × 720 (v4: the squares of the maps astride the bottom of the stone, the robot astride its top). Layout only, no colors. Sample progress: levels 1 to 17 done, 18 open with its map 1 passed, 19 and 20 locked.",
   "originalText": "Layout C, the path, at 1280 × 720 (v4: the squares of the maps astride the bottom of the stone, the robot astride its top). Layout only, no colors. Sample progress: levels 1 to 17 done, 18 open with its map 1 passed, 19 and 20 locked.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v2-text-3",
   "type": "text",
   "x": 0,
   "y": 70,
   "width": 1874.4,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#868e96",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 311111476,
   "version": 1,
   "versionNonce": 404285458,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "Stones: filled = done, bold = the level to play, dashed = locked; the robot stands on the level chosen. Squares under a stone: one per map, filled (green) once passed, empty (grey) until then; never a failed mark.",
   "originalText": "Stones: filled = done, bold = the level to play, dashed = locked; the robot stands on the level chosen. Squares under a stone: one per map, filled (green) once passed, empty (grey) until then; never a failed mark.",
