{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "node"]
	},
	"include": ["src", "scripts", "vite.config.ts", "prettier.config.js", "eslint.config.js"],
	// The glue generated by wasm-bindgen is typed by its `.d.ts` files, not checked as code.
	"exclude": ["src/lib/wasm/*.js"]
}
